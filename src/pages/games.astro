---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectsIn } from '../lib/projects';
const projects = await projectsIn('games');
---

<Layout
  title="Games"
  description="Explore Kingdom TD: Draft Your Demise and Lone Survivors, independent games by Colton Donkersgoed."
  active="games"
>
  <header class="page-title">
    <span class="eyebrow">THE COLLECTION / GAMES</span>
    <h1>Find your next adventure.</h1>
    <p>Worlds to explore. Decisions to live with. One more run.</p>
  </header>
  <div class="project-grid category-grid">
    {projects.map((project) => (
      <ProjectCard project={project} eager headingLevel="h2" />
    ))}
  </div>
</Layout>
