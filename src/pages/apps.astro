---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectsIn } from '../lib/projects';
const projects = await projectsIn('apps');
---

<Layout
  title="Apps"
  description="BoulderLog and Shelf & Score: personal apps for climbing sessions and board game nights, by Colton Donkersgoed."
  active="apps"
>
  <header class="page-title">
    <span class="eyebrow">THE COLLECTION / APPS</span>
    <h1>For life outside the lobby.</h1>
    <p>Useful companions for the things I love doing.</p>
  </header>
  <div class="project-grid category-grid">
    {projects.map((project) => (
      <ProjectCard project={project} eager headingLevel="h2" />
    ))}
  </div>
</Layout>
