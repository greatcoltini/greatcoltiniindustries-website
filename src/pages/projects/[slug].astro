---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import Trailer from '../../components/Trailer.astro';
import ProjectAvailability from '../../components/ProjectAvailability.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import Icon from '../../components/Icon.astro';
import {
  projectsIn,
  projectUrl,
  chapterNames,
  type Project,
} from '../../lib/projects';
export async function getStaticPaths() {
  const projects = await projectsIn();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}
interface Props {
  project: Project;
  projects: Project[];
}
const { project, projects } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const category = chapterNames[data.category];
const sectionUrl = `/#${data.category}`;
const poster =
  data.trailer && data.artwork
    ? await getImage({ src: data.artwork, width: 960, format: 'webp' })
    : undefined;
// Prefer other mods for the same game, then the rest of the category.
const others = projects.filter(
  (p) => p.id !== project.id && p.data.category === data.category,
);
const sameHost = data.hostGame
  ? others.filter((p) => p.data.hostGame === data.hostGame)
  : [];
const related = (sameHost.length ? sameHost : others).slice(0, 3);
const relatedTitle = sameHost.length
  ? `More ${data.hostGame} mods`
  : `More ${category.toLowerCase()}`;
// Landscape artwork gets a wider thumbnail; square mod and app art stays square.
const isWide = (p: Project) =>
  ['cover', 'boulderlog'].includes(p.data.artStyle);
---

<Layout
  title={data.title}
  description={data.summary}
  active={data.category}
  socialImage={`/social/${project.id}.jpg`}
  socialImageAlt={`${data.title} — Great Coltini Industries`}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href={sectionUrl}>{category}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{data.shortTitle || data.title}</span>
  </nav>
  <article>
    <div class="detail-hero">
      <section class="detail-intro" aria-labelledby="project-title">
        <p class="eyebrow">
          <Icon name={data.category} />{' '}
          {data.hostGame
            ? `A mod for ${data.hostGame}`
            : data.category === 'games'
              ? 'INDEPENDENT GAME'
              : 'PERSONAL APP'}
        </p>
        <h1 id="project-title">{data.title}</h1>
        <ProjectAvailability project={project} detailed />
        <p class="project-summary">{data.summary}</p>
        {data.links.length > 0 && (
          <div class="project-actions">
            {data.links.map((link, i) => (
              <a
                class:list={['button', { 'button-secondary': i > 0 }]}
                href={link.url}
              >
                {link.label}
                <Icon name="external" size={17} />
              </a>
            ))}
          </div>
        )}
        {data.listingName && (
          <p class="listing-name">Steam Workshop listing: {data.listingName}</p>
        )}
        <div class="tech-tags">
          {data.tech.map((tech) => (
            <span>{tech}</span>
          ))}
        </div>
      </section>
      <div class="detail-media">
        {data.trailer ? (
          <Trailer
            src={data.trailer}
            poster={poster?.src}
            title={data.shortTitle || data.title}
          >
            <ProjectArt project={project} eager decorative />
          </Trailer>
        ) : (
          <ProjectArt project={project} eager />
        )}
      </div>
    </div>
    <nav class="local-nav" aria-label="On this project page">
      <a href="#overview">Overview</a>
      <a href="#features">Features</a>
      {data.screenshots.length > 0 && <a href="#screenshots">Screenshots</a>}
      <a href="#development">Development</a>
    </nav>
    <div class="detail-body">
      <section class="prose" id="overview" aria-labelledby="overview-title">
        <h2 id="overview-title">{data.overviewTitle}</h2>
        {data.overview.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
      <section
        id="features"
        class="features-panel"
        aria-labelledby="features-title"
      >
        <span class="eyebrow">THE EXPERIENCE</span>
        <h2 id="features-title">
          {data.category === 'games' ? 'How it plays' : 'What it does'}
        </h2>
        <ul class="app-features">
          {data.features.map((feature, index) => (
            <li>
              <span class="feature-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>
    {data.screenshots.length > 0 && (
      <ScreenshotGallery screenshots={data.screenshots} />
    )}
    <section class="prose development-notes" aria-label="Development notes">
      <Content />
    </section>
    {related.length > 0 && (
      <section class="onward" aria-labelledby="onward-title">
        <h2 id="onward-title">{relatedTitle}</h2>
        <div class="onward-links">
          {related.map((next) => (
            <a class="onward-link" href={projectUrl(next)}>
              {next.data.artwork ? (
                <Image
                  class:list={[
                    'onward-thumb',
                    { 'onward-thumb-wide': isWide(next) },
                  ]}
                  src={next.data.artwork}
                  alt=""
                  width={isWide(next) ? 192 : 128}
                  format="webp"
                  loading="lazy"
                />
              ) : (
                <span class="onward-thumb mod-icon-tile" aria-hidden="true">
                  <Icon name={next.data.category} size={30} />
                </span>
              )}
              <span>
                <strong>{next.data.shortTitle || next.data.title}</strong>
                <span>{next.data.summary}</span>
              </span>
              <Icon name="arrow" />
            </a>
          ))}
        </div>
      </section>
    )}
    <a class="text-action back-link" href={sectionUrl}>
      <Icon name="back" /> Back to {category.toLowerCase()}
    </a>
  </article>
</Layout>
