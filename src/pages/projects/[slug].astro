---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import Icon from '../../components/Icon.astro';
import { projectsIn, chapterNames, type Project } from '../../lib/projects';
export async function getStaticPaths() {
  return (await projectsIn()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const category = chapterNames[data.category];
const poster =
  data.trailer && data.artwork
    ? await getImage({ src: data.artwork, width: 960, format: 'webp' })
    : undefined;
---

<Layout title={data.title} description={data.summary} active={data.category}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Discover</a>
    <span aria-hidden="true">/</span>
    <a href={`/${data.category}/`}>{category}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{data.shortTitle || data.title}</span>
  </nav>
  <article>
    <div class="detail-hero">
      <section class="detail-intro" aria-labelledby="project-title">
        <p class="eyebrow">
          <Icon name={data.category} />{' '}
          {data.hostGame
            ? `A mod for ${data.hostGame}`
            : data.category === 'games'
              ? 'INDEPENDENT GAME'
              : 'PERSONAL APP'}
        </p>
        <h1 id="project-title">{data.title}</h1>
        <p class="project-summary">{data.summary}</p>
        {data.links.length > 0 && (
          <div class="project-actions">
            {data.links.map((link, i) => (
              <a
                class:list={['button', { 'button-secondary': i > 0 }]}
                href={link.url}
              >
                {link.label}
                <Icon name="external" size={17} />
              </a>
            ))}
          </div>
        )}
        <div class="tech-tags">
          {data.tech.map((tech) => (
            <span>{tech}</span>
          ))}
        </div>
      </section>
      <div class="detail-media">
        <ProjectArt project={project} eager />
        {data.trailer && (
          <details class="trailer" id="trailer">
            <summary>
              <Icon name="play" /> Watch gameplay trailer
            </summary>
            <video
              controls
              preload="none"
              poster={poster?.src}
              width="1920"
              height="1080"
              aria-label="Kingdom TD gameplay trailer"
            >
              <source src={data.trailer} type="video/mp4" />
              Your browser does not support this video.{' '}
              <a href={data.trailer}>Open the gameplay trailer</a>.
            </video>
          </details>
        )}
      </div>
    </div>
    <nav class="local-nav" aria-label="On this project page">
      <a href="#overview">Overview</a>
      <a href="#features">Features</a>
      <a href="#development">Development</a>
      {data.trailer && <a href="#trailer">Trailer</a>}
    </nav>
    <div class="detail-body">
      <section id="features" class="features-panel">
        <span class="eyebrow">THE EXPERIENCE</span>
        <h2>{data.category === 'games' ? 'How it plays' : 'What it does'}</h2>
        <ul class="app-features">
          {data.features.map((f, i) => (
            <li>
              <span class="feature-number" aria-hidden="true">
                0{i + 1}
              </span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
      <section
        class="prose"
        id="overview"
        aria-label="Project overview and development"
      >
        <Content />
      </section>
    </div>
    <a class="text-action back-link" href={`/${data.category}/`}>
      <Icon name="back" /> Back to {category.toLowerCase()}
    </a>
  </article>
</Layout>
