---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="This page is missing. Head back to the Great Coltini collection."
  noindex
>
  <section class="page-title missing-page">
    <span class="eyebrow">ERROR 404 / OUT OF BOUNDS</span>
    <h1>You’ve wandered off the map.</h1>
    <p>This page may have moved. The collection is right this way.</p>
    <a class="button" href="/">
      Back to Discover →
    </a>
  </section>
</Layout>
