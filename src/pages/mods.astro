---
import Layout from '../layouts/Layout.astro';
import ModGameHeading from '../components/ModGameHeading.astro';
import { modGroups as groups } from '../lib/mod-groups';
import ModEntry from '../components/ModEntry.astro';
import { projectsIn } from '../lib/projects';
const mods = await projectsIn('mods');
---

<Layout
  title="Mods"
  description="Maps and mods for Meccha Chameleon, R.E.P.O., Valheim, and Necesse by Colton Donkersgoed."
  active="mods"
>
  <header class="page-title">
    <span class="eyebrow">THE COLLECTION / MODS</span>
    <h1>Make it your kind of game.</h1>
    <p>
      New systems, familiar enemies, and small changes that make a big
      difference.
    </p>
  </header>
  <nav class="section-jumps" aria-label="Browse mods by game">
    <span>JUMP TO</span>
    {groups.map((g) => (
      <a href={`#${g.id}`}>{g.name}</a>
    ))}
  </nav>
  {groups.map((g) => (
    <section class="mod-group" id={g.id}>
      <div class="section-heading">
        <ModGameHeading name={g.name} game={g.id} level="h2" />
        <p>{g.note}</p>
      </div>
      <div class="mod-grid">
        {mods
          .filter((p) => p.data.hostGame === g.name)
          .map((project) => (
            <ModEntry project={project} />
          ))}
      </div>
    </section>
  ))}
  <p class="muted">
    Fan-made additions. Each project explains what I built and the game or mod
    it builds on.
  </p>
</Layout>
