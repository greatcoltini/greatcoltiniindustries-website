---
import Layout from '../layouts/Layout.astro';
import ModGameHeading from '../components/ModGameHeading.astro';
import { modGroups as groups } from '../lib/mod-groups';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import AppPreview from '../components/AppPreview.astro';
import ProjectAvailability from '../components/ProjectAvailability.astro';
import LatestUpdate from '../components/LatestUpdate.astro';
import kingdomCover from '../assets/kingdom-td.jpg';
import kingdomDraft from '../assets/screenshots/kingdom-td-2.jpg';
import loneCover from '../assets/lone-survivors.png';
import boulderWall from '../assets/boulderlog-wall.png';
import shelfIcon from '../assets/shelf-and-score.png';

import loneTeam from '../assets/lone-team.png';
import { projectsIn, projectUrl } from '../lib/projects';
import { profiles } from '../lib/profiles';
const projects = await projectsIn();
const games = projects.filter((p) => p.data.category === 'games');
const apps = projects.filter((p) => p.data.category === 'apps');
---

<Layout
  title="Home"
  description="Games, apps, and mods by Colton Donkersgoed. Explore Kingdom TD, Lone Survivors, BoulderLog, Shelf & Score, and the things I make for the way I like to play."
>
  <section class="intro-section content-width" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">THE PERSONAL PROJECTS OF COLTON DONKERSGOED</p>
      <h1 id="intro-title" class="big-type">
        <span>PLAY.</span>
        <span class="blue-text">MAKE.</span>
        <span>REPEAT.</span>
      </h1>
      <p class="intro-note">
        Hi, I’m <strong>Colton.</strong> I make games, apps, and mods—usually
        starting with something I want to play or use myself.
      </p>
      <div class="intro-actions">
        <a class="button" href="#games">
          Explore my projects <Icon name="arrow" />
        </a>
        <a class="text-action" href="#about">
          About me <Icon name="arrow" />
        </a>
      </div>
      <LatestUpdate stacked />
    </div>
    <div class="project-collage" aria-label="Explore my projects">
      <div class="collage-grid" aria-hidden="true"></div>
      <a
        class="collage-piece collage-kingdom"
        href="/projects/kingdom-td/"
        aria-label="Explore Kingdom TD"
      >
        <Image
          src={kingdomDraft}
          alt="Kingdom TD enemy draft screen"
          widths={[400, 640, 960]}
          sizes="(max-width: 700px) 70vw, 42vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <span class="collage-label">
          01 / KINGDOM TD <Icon name="arrow" />
        </span>
      </a>
      <a
        class="collage-piece collage-lone"
        href="/projects/lone-survivors/"
        aria-label="Explore Lone Survivors"
      >
        <Image
          src={loneCover}
          alt="Lone Survivors"
          widths={[400, 640, 960]}
          sizes="(max-width: 700px) 70vw, 40vw"
          format="webp"
          loading="eager"
        />
        <span class="collage-label">
          02 / LONE SURVIVORS <Icon name="arrow" />
        </span>
      </a>
      <a
        class="collage-piece collage-boulder"
        href="/projects/boulderlog/"
        aria-label="Explore BoulderLog"
      >
        <Image
          src={boulderWall}
          alt="BoulderLog climbing artwork"
          width={400}
          format="webp"
          loading="eager"
        />
        <span class="small-sticker">BoulderLog →</span>
      </a>
      <a
        class="collage-piece collage-shelf"
        href="/projects/shelf-and-score/"
        aria-label="Explore Shelf & Score"
      >
        <Image
          src={shelfIcon}
          alt="Shelf & Score app icon"
          width={256}
          format="webp"
          loading="eager"
        />
      </a>
      <span class="margin-note" aria-hidden="true">
        Start
        <br /> anywhere.
        <svg viewBox="0 0 100 55" fill="none">
          <path
            d="M6 5c54-5 66 21 65 39m-15-9 15 12 12-15"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </span>
      <span class="collage-cross" aria-hidden="true">
        +
      </span>
    </div>
  </section>
  <div class="scroll-cue content-width">
    <a href="#games">
      SCROLL TO EXPLORE <span aria-hidden="true">↓</span>
    </a>
    <LatestUpdate />
  </div>
  <section
    class="games-section content-width scroll-section"
    id="games"
    aria-labelledby="games-title"
  >
    <header class="section-opening">
      <div>
        <span class="section-index">
          01 <span aria-hidden="true"></span> GAMES
        </span>
        <h2 class="big-type" id="games-title">
          One more run.
        </h2>
      </div>
      <p>
        Different worlds.
        <br /> The same “what if?” that gets me building.
      </p>
    </header>
    {games.map((project, index) => (
      <article
        class:list={[
          'game-feature',
          'scroll-reveal',
          { 'game-reverse': index === 1 },
        ]}
      >
        <a
          class="game-visual"
          href={projectUrl(project)}
          aria-label={`Explore ${project.data.title}`}
        >
          <Image
            src={index === 0 ? kingdomCover : loneTeam}
            alt={
              index === 0
                ? 'Kingdom TD: Draft Your Demise cover art.'
                : 'Lone Survivors warrior, mage, and barbarian artwork.'
            }
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 800px) 92vw, 55vw"
            format="webp"
            loading="lazy"
          />
          <span class="image-caption">
            {index === 0
              ? 'KINGDOM TD / DRAFT YOUR DEMISE'
              : 'MEET THE HORDE / LONE SURVIVORS'}
            <Icon name="arrow" size={18} />
          </span>
          <span class="corner-number" aria-hidden="true">
            0{index + 1}
          </span>
        </a>
        <div class="game-copy">
          <span class="eyebrow">
            {index === 0
              ? 'DRAFT. BUILD. DEFEND.'
              : 'SURVIVE. UPGRADE. GO AGAIN.'}
          </span>
          <h3 class="big-type">
            {project.data.shortTitle || project.data.title}
          </h3>
          {index === 0 && <p class="game-subtitle">Draft Your Demise</p>}
          <ProjectAvailability project={project} />
          <p class="feature-summary">{project.data.summary}</p>
          <p>
            {index === 0
              ? 'The next wave starts with your choice. Draft the enemies, shape their route, and build a defense that can handle the consequences.'
              : 'Pick a class, find the upgrades that click, and take on a growing horde. There’s always another build to try.'}
          </p>
          <div class="feature-actions">
            {project.data.links.map((link) => (
              <a class="button" href={link.url}>
                {link.label}
                <Icon name="external" size={18} />
              </a>
            ))}
            <a
              class="text-action"
              href={projectUrl(project)}
              aria-label={`About ${project.data.title}`}
            >
              Inside the project <Icon name="arrow" />
            </a>
          </div>
          <p class="project-credit">{project.data.tech.join(' / ')}</p>
        </div>
      </article>
    ))}
  </section>
  <section
    class="apps-section scroll-section"
    id="apps"
    aria-labelledby="apps-title"
  >
    <div class="content-width">
      <header class="section-opening">
        <div>
          <span class="section-index">
            02 <span aria-hidden="true"></span> APPS
          </span>
          <h2 class="big-type" id="apps-title">
            Useful outside
            <br /> the game, too.
          </h2>
        </div>
        <p>
          From the climbing wall
          <br /> to the board game table.
        </p>
        <span class="apps-mark" aria-hidden="true">
          →
        </span>
      </header>
      <div class="app-stories">
        {apps.map((project, index) => (
          <article class="app-story scroll-reveal">
            <a
              class:list={[
                'app-canvas',
                index === 0 ? 'climbing-canvas' : 'boardgame-canvas',
              ]}
              href={projectUrl(project)}
              aria-label={`Explore ${project.data.title}`}
            >
              <AppPreview project={project} />
              <span class="canvas-label">
                {index === 0 ? 'FOR THE NEXT CLIMB' : 'FOR THE NEXT GAME NIGHT'}
              </span>
              <span class="canvas-arrow" aria-hidden="true">
                →
              </span>
            </a>
            <div class="app-description">
              <h3>{project.data.title}</h3>
              <ProjectAvailability project={project} />
              <p>
                {index === 0
                  ? 'Track climbs, log sessions, and see your progress. A place for the details worth remembering between trips to the wall.'
                  : 'Track your board game collection, log plays, and keep the scores and stories from game night.'}
              </p>
              <a
                class="text-action"
                href={projectUrl(project)}
                aria-label={`About ${project.data.title}`}
              >
                About the project <Icon name="arrow" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section
    class="mods-section content-width scroll-section"
    id="mods"
    aria-labelledby="mods-title"
  >
    <header class="section-opening">
      <div>
        <span class="section-index">
          03 <span aria-hidden="true"></span> MODS
        </span>
        <h2 class="big-type" id="mods-title">
          A few changes.
          <br /> A different game.
        </h2>
      </div>
      <p>
        I mod the games I love
        <br /> to play them a little more my way.
      </p>
    </header>
    <nav class="section-jumps" aria-label="Browse mods by game">
      <span>JUMP TO</span>
      {groups.map((group) => (
        <a href={`#mods-${group.id}`}>{group.name}</a>
      ))}
    </nav>
    <div class="mod-index">
      {groups.map((group, index) => (
        <section
          class="mod-index-group scroll-reveal"
          id={`mods-${group.id}`}
          aria-label={`${group.name} mods`}
        >
          <div class="mod-host">
            <span class="eyebrow">
              {String(index + 1).padStart(2, '0')} / MODDED WORLD
            </span>
            <ModGameHeading name={group.name} game={group.id} />
            <p>{group.note}</p>
          </div>
          <div class="mod-index-links">
            {projects
              .filter((p) => p.data.hostGame === group.name)
              .map((project) => (
                <a class="mod-index-link" href={projectUrl(project)}>
                  {project.data.artwork ? (
                    <Image
                      src={project.data.artwork}
                      alt=""
                      width={80}
                      height={80}
                      format="webp"
                      loading="lazy"
                    />
                  ) : (
                    <span class="mod-icon-tile" aria-hidden="true">
                      <Icon name="mods" size={30} />
                    </span>
                  )}
                  <span>
                    <strong>
                      {project.data.shortTitle || project.data.title}
                    </strong>
                    <span>{project.data.summary}</span>
                  </span>
                  <Icon name="arrow" />
                </a>
              ))}
          </div>
        </section>
      ))}
    </div>
    <p class="mod-footnote">
      Fan-made projects. Original games belong to their creators.
    </p>
  </section>
  <section
    class="about-section scroll-section"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="content-width about-home-grid">
      <div>
        <span class="section-index">
          04 <span aria-hidden="true"></span> ABOUT
        </span>
        <h2 class="big-type" id="about-title">
          Built by
          <br /> <span>Colton.</span>
        </h2>
        <span class="about-signoff" aria-hidden="true">
          Still playing.
          <br /> Still building.<span>→</span>
        </span>
      </div>
      <div class="about-home-copy">
        <h3>Colton Donkersgoed</h3>
        <p>
          I’m an AI software developer at Kinaxis and a lifelong gaming
          enthusiast. I create games, apps, and mods, often starting with
          something I want to use myself.
        </p>
        <p>
          Modding lets me configure the games I love around the way I like to
          play. Some of my favourite competitive games are League of Legends and
          StarCraft II.
        </p>
        <p>GreatColtini Industries is where my personal projects live.</p>
        <a class="contact-link" href="mailto:coltonmdonk@gmail.com">
          <Icon name="mail" size={24} /> coltonmdonk@gmail.com
        </a>
        <ul class="profile-links" aria-label="Profiles">
          {profiles.map((profile) => (
            <li>
              <a href={profile.url}>
                {profile.label} <Icon name="external" size={18} />
              </a>
            </li>
          ))}
        </ul>
        <div class="about-fact-line">
          <span>AT WORK</span>
          <strong>AI software development · Kinaxis</strong>
        </div>
        <div class="about-fact-line">
          <span>AFTER HOURS</span>
          <strong>Games, apps, and a little tinkering.</strong>
        </div>
      </div>
    </div>
  </section>
</Layout>
<script>
  const sections = [
    ...document.querySelectorAll<HTMLElement>('.scroll-section'),
  ];
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      '.main-nav a[data-section]',
    ),
  ];
  let scheduled = false;
  const updateActiveSection = () => {
    const boundary = Math.min(innerHeight * 0.35, 220);
    const active = sections
      .filter((section) => section.getBoundingClientRect().top <= boundary)
      .at(-1)?.id;
    links.forEach((link) =>
      active === link.dataset.section
        ? link.setAttribute('aria-current', 'location')
        : link.removeAttribute('aria-current'),
    );
    scheduled = false;
  };
  const scheduleUpdate = () => {
    if (!scheduled) {
      scheduled = true;
      requestAnimationFrame(updateActiveSection);
    }
  };
  addEventListener('scroll', scheduleUpdate, { passive: true });
  addEventListener('resize', scheduleUpdate);
  updateActiveSection();
  if ('IntersectionObserver' in window) {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealObserver = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('arrived');
              revealObserver.unobserve(entry.target);
            }
          }),
        { threshold: 0.08 },
      );
      document
        .querySelectorAll('.scroll-reveal')
        .forEach((element) => revealObserver.observe(element));
    }
  }
</script>
