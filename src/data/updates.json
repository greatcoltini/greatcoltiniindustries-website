        {
          "id": "steam-1845383656392710",
          "date": "2026-10-05T07:02:34.000Z",
          "title": "Game Juice Update!",
          "summary": "Hey Survivors! 1.3.0 is all about how the game feels. Every hit, kill, upgrade card, chest, boss and class ability now has new effects and sounds behind it.",
          "version": "1.3.0",
          "kind": "patch",
          "url": "https://steamcommunity.com/games/3629280/announcements/detail/699903325897754704"
        },
        {
          "id": "steam-1844751498232541",
          "date": "2026-09-28T21:15:43.000Z",
          "title": "New Skins & Cheaper Upgrades",
          "summary": "Hey Survivors! Patch 1.2.11 adds nine new skins and makes two class upgrade trees much more affordable, with total costs reduced by around 90%.",
          "version": "1.2.11",
          "kind": "patch",
          "url": "https://steamcommunity.com/games/3629280/announcements/detail/701028593652729992"
        },
        {
          "id": "steam-1840310314352466",
          "date": "2026-08-10T20:08:57.000Z",
          "title": "Queen Bee",
          "summary": "Hello everyone, I'm here to welcome a new boss, new weapon, and a minor fix to the alchemy table (long-awaited...)",
          "version": "1.2.10",
          "kind": "patch",
          "url": "https://steamcommunity.com/games/3629280/announcements/detail/684135653863065118"
        },
        {
          "id": "steam-1839676055887096",
          "date": "2026-07-31T04:34:12.000Z",
          "title": "Announcing Kingdom TD: Draft Your Demise — My New Tower Defense Game",
          "summary": "Hi everyone! I'm excited to finally share the new project I've been working on: Kingdom TD: Draft Your Demise, a fantasy tower defense game where you choose the enemies you'll have to survive against in battle.",
          "kind": "news",
          "url": "https://steamcommunity.com/games/3629280/announcements/detail/715660216997250635"
        },
        {
          "id": "steam-1837955055361712",
          "date": "2026-07-12T19:25:41.000Z",
          "title": "Patch notes",
          "summary": "Alchemy table placement should be stricter, no more OOB Endless level cap is now visible in pause menu (under Pause)",
          "version": "1.2.9",
          "kind": "patch",
          "url": "https://steamcommunity.com/games/3629280/announcements/detail/669496599819322880"
