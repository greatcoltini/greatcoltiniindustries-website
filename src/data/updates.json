      {
        "id": "bsky-3mwphy3qu7k2a",
        "date": "2026-09-30T04:10:51.598Z",
        "title": "Day 1 vs day 82 of Kingdom TD: Draft Your Demise",
        "summary": "July 9: flat 2D prototype. Today: floating 3D islands, storms, 12 tower types and a Goblin King boss wave.",
        "text": "Day 1 vs day 82 of Kingdom TD: Draft Your Demise July 9: flat 2D prototype. Today: floating 3D islands, storms, 12 tower types and a Goblin King boss wave. Draft your enemies, then build a defense that survives them. Wishlist: store.steampowered.com/app/4990780 #gamedev #indiedev #godotengine",
        "url": "https://bsky.app/profile/did:plc:u4hg37hskhzvj67ni33dbdrr/post/3mwphy3qu7k2a",
        "media": {
          "kind": "video",
          "href": "https://bsky.app/profile/did:plc:u4hg37hskhzvj67ni33dbdrr/post/3mwphy3qu7k2a",
          "alt": "A tower defense game 82 days apart. July 9: a flat 2D prototype with a brown path and simple sprites. Today: a 3D floating island rises from the clouds, a card draft picks enemy waves, and towers fire lightning and cannons across four battlefields in sun and rain. A Goblin King boss marches between purple portals under fire, then the Kingdom TD logo appears.",
          "image": "bsky-3mwphy3qu7k2a.jpg"
        }
      },
