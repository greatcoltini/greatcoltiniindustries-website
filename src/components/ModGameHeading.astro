---
import { Image } from 'astro:assets';
import meccha from '../assets/game-logos/meccha.webp';
import repo from '../assets/game-logos/repo.webp';
import valheim from '../assets/game-logos/valheim.webp';
import necesse from '../assets/game-logos/necesse.webp';
const logos = { meccha, repo, valheim, necesse };
interface Props {
  name: string;
  game: keyof typeof logos;
  level?: 'h2' | 'h3';
}
const { name, game, level: Tag = 'h3' } = Astro.props;
---

<Tag class="game-heading">
  <span class="sr-only">{name}</span>
  <span class="game-logo-frame" aria-hidden="true">
    <Image
      src={logos[game]}
      alt=""
      width={560}
      widths={[280, 560, 840]}
      sizes="280px"
      loading="lazy"
      decoding="async"
    />
  </span>
</Tag>
<style>
  .game-heading {
    margin: 12px 0;
    width: min(100%, 280px);
    flex-shrink: 0;
  }
  .game-logo-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 2.5;
    padding: 16px;
    background: #16191f;
    border: 1px solid #353a43;
  }
  .game-logo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
