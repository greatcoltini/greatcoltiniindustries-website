---
import { Image } from 'astro:assets';
import meccha from '../assets/game-logos/meccha.webp';
import repo from '../assets/game-logos/repo.webp';
import valheim from '../assets/game-logos/valheim.webp';
import necesse from '../assets/game-logos/necesse.webp';
const logos = { meccha, repo, valheim, necesse };
const productPages = {
  meccha: 'https://store.steampowered.com/app/4704690/',
  repo: 'https://store.steampowered.com/app/3241660/',
  valheim: 'https://store.steampowered.com/app/892970/',
  necesse: 'https://store.steampowered.com/app/1169040/',
};
interface Props {
  name: string;
  game: keyof typeof logos;
  level?: 'h2' | 'h3';
}
const { name, game, level: Tag = 'h3' } = Astro.props;
---

<Tag class="game-heading" aria-label={name}>
  <a
    class="game-logo-link"
    href={productPages[game]}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${name} on Steam (opens in a new tab)`}
    title={`View ${name} on Steam (opens in a new tab)`}
  >
    <span class="sr-only">{name}</span>
    <Image
      src={logos[game]}
      alt=""
      width={560}
      widths={[280, 560, 840]}
      sizes="280px"
      loading="lazy"
      decoding="async"
    />
    <span class="steam-cue" aria-hidden="true">
      Steam ↗
    </span>
  </a>
</Tag>
<style>
  .game-heading {
    margin: 12px 0;
    width: min(100%, 280px);
    flex-shrink: 0;
  }
  .game-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    background: transparent;
    text-decoration: none;
  }
  .game-logo-link img {
    display: block;
    width: 100%;
    height: 100px;
    object-fit: contain;
  }
  .steam-cue {
    font:
      600 15px/1.4 'Source Sans 3',
      sans-serif;
    color: var(--blue);
    letter-spacing: 0;
  }
</style>
