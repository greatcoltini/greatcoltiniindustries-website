---
import { Image } from 'astro:assets';
import meccha from '../assets/game-logos/meccha.webp';
import repo from '../assets/game-logos/repo.webp';
import valheim from '../assets/game-logos/valheim.webp';
import necesse from '../assets/game-logos/necesse.webp';
const logos = { meccha, repo, valheim, necesse };
const productPages = {
  meccha: 'https://store.steampowered.com/app/4704690/',
  repo: 'https://store.steampowered.com/app/3241660/',
  valheim: 'https://store.steampowered.com/app/892970/',
  necesse: 'https://store.steampowered.com/app/1169040/',
};
interface Props {
  name: string;
  game: keyof typeof logos;
  level?: 'h2' | 'h3';
}
const { name, game, level: Tag = 'h3' } = Astro.props;
---

<Tag class="game-heading">
  <span class="sr-only">{name}</span>
  <Image
    src={logos[game]}
    alt=""
    width={560}
    widths={[280, 560, 840]}
    sizes="(max-width: 800px) 136px, 280px"
    loading="lazy"
    decoding="async"
  />
</Tag>
<a
  class="steam-link"
  href={productPages[game]}
  target="_blank"
  rel="noopener noreferrer"
>
  {name} on Steam{'\u00a0'}
  <span aria-hidden="true">↗</span>
  <span class="sr-only">(opens in a new tab)</span>
</a>
