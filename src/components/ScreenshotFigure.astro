---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
interface Props {
  shot: Project['data']['screenshots'][number] & { full: { src: string } };
  index: number;
  portrait?: boolean;
}
const { shot, index, portrait = false } = Astro.props;
---

<figure class:list={{ portrait }}>
  <a
    href={shot.full.src}
    data-screenshot-index={index}
    data-caption={shot.caption}
    data-alt={shot.alt}
    aria-label={`Open screenshot: ${shot.caption}`}
  >
    <Image
      src={shot.image}
      alt={shot.alt}
      width={Math.min(960, shot.image.width)}
      widths={[320, 640, 960].filter((width) => width <= shot.image.width)}
      sizes={
        portrait
          ? '(max-width: 700px) 30vw, 220px'
          : '(max-width: 700px) 85vw, 600px'
      }
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>{shot.caption}</figcaption>
</figure>
<style>
  figure {
    margin: 0;
    min-width: 0;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .portrait a {
    aspect-ratio: auto;
  }
  a:hover {
    border-color: var(--blue);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .portrait img {
    height: auto;
  }
  figcaption {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    padding-top: 12px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 700px) {
    .portrait figcaption {
      font-size: 14px;
      padding-top: 8px;
    }
  }
</style>
