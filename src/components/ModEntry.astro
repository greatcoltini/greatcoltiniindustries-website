---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
import { projectUrl } from '../lib/projects';
import Icon from './Icon.astro';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="mod-entry">
  <div class="mod-entry-top">
    {project.data.artwork ? (
      <Image
        src={project.data.artwork}
        alt=""
        width={88}
        height={88}
        format="webp"
        loading="lazy"
      />
    ) : (
      <div class="mod-entry-icon" aria-hidden="true">
        <Icon name="mods" size={34} />
      </div>
    )}
    <div>
      <h3>
        <a href={projectUrl(project)}>
          {project.data.shortTitle || project.data.title}
        </a>
      </h3>
      <p>{project.data.summary}</p>
    </div>
  </div>
  <a
    class="project-link"
    href={projectUrl(project)}
    aria-label={`View mod: ${project.data.title}`}
  >
    View mod <Icon name="arrow" size={18} />
  </a>
</article>
