---
import { projectUrl, type Project } from '../lib/projects';
import { formatDate, latestRelease } from '../lib/updates';
interface Props {
  project: Project;
  detailed?: boolean;
}
const { project, detailed = false } = Astro.props;
const { availability, roadmap } = project.data;
const latest = latestRelease(project);
const updated =
  latest &&
  `Updated ${formatDate(latest.date)}${latest.version ? ` · v${latest.version}` : ''}`;
// Before launch, point at the road to launch instead.
const nextStep = roadmap.find((step) => step.status === 'next');
const done = roadmap.filter((step) => step.status === 'done').length;
const launch =
  nextStep &&
  `Next up: ${nextStep.title} · ${done} of ${roadmap.length} steps done`;
---

<div class="project-availability">
  <p class="availability-label">{availability.label}</p>
  <p class="availability-platform">{availability.platform}</p>
  {detailed && availability.detail && (
    <p class="availability-detail">{availability.detail}</p>
  )}
  {updated &&
    (detailed ? (
      <a class="availability-updated" href="#updates">
        <span aria-hidden="true"></span>
        {updated}
      </a>
    ) : (
      <p class="availability-updated">{updated}</p>
    ))}
  {launch && (
    <a
      class:list={['availability-launch', { 'availability-pill': detailed }]}
      href={detailed ? '#launch' : `${projectUrl(project)}#launch`}
    >
      <span aria-hidden="true"></span>
      {launch}
    </a>
  )}
</div>
<style>
  .project-availability {
    margin: 14px 0 20px;
  }
  .project-availability p {
    color: inherit;
    margin: 0;
    line-height: 1.5;
    font-size: 15px;
  }
  .availability-label {
    font-weight: 600;
  }
  .project-availability .availability-detail {
    margin-top: 6px;
  }
  p.availability-updated {
    margin-top: 6px;
    opacity: 0.85;
  }
  .availability-launch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 6px;
    color: inherit;
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .availability-launch span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e3f684;
    box-shadow: 0 0 0 2px var(--cobalt);
  }
  a.availability-updated,
  a.availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 12px;
    padding: 0 14px;
    background: #e3f684;
    color: #171817;
    font-size: 15px;
    font-weight: 600;
  }
  a.availability-pill {
    text-decoration: none;
  }
  a.availability-updated:hover,
  a.availability-pill:hover {
    color: #171817;
    text-decoration: underline;
  }
  a.availability-pill span {
    box-shadow: none;
  }
  a.availability-updated span,
  a.availability-pill span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
</style>
