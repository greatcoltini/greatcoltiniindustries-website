---
import '../styles/global.css';
import '@fontsource/anton/latin-400.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import Icon from '../components/Icon.astro';
import ThemeControl from '../components/ThemeControl.astro';
interface Props {
  title: string;
  description: string;
  active?: string;
  noindex?: boolean;
}
const { title, description, active, noindex = false } = Astro.props;
const isHome = title === 'Home';
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = isHome
  ? 'Great Coltini Industries — Games, Apps & Mods'
  : `${title} · Great Coltini Industries`;
const nav = [
  { id: 'games', label: 'Games' },
  { id: 'apps', label: 'Apps' },
  { id: 'mods', label: 'Mods' },
  { id: 'about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a saved override before the first paint; otherwise CSS follows the browser.
      try {
        const theme = localStorage.getItem('gci-theme');
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
      } catch {
        /* System preference remains the default. */
      }
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={[isHome ? 'home-page' : 'interior-page']}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header" id="top">
      <div class="header-inner">
        <a
          class="wordmark"
          href="/"
          aria-label="Great Coltini Industries — Home"
        >
          <span>GREAT COLTINI</span> INDUSTRIES
          <span class="brand-dot" aria-hidden="true">
            +
          </span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={isHome ? `#${item.id}` : `/#${item.id}`}
              data-section={item.id}
              aria-current={active === item.id ? 'true' : undefined}
            >
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
        <ThemeControl />
      </div>
    </header>
    <main
      id="main"
      class:list={[isHome ? 'home-main' : 'interior-main']}
      tabindex="-1"
    >
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="footer-wordmark" href="/">
          GREAT COLTINI INDUSTRIES
        </a>
        <small>© {new Date().getFullYear()} Colton Donkersgoed</small>
        <a href="#top">
          Back to top <Icon name="arrow" size={18} />
        </a>
      </div>
    </footer>
  </body>
</html>
